# Somente valores PÚBLICOS (vão para o JavaScript do navegador).
# Gere o .env.local automaticamente a partir do .env da raiz:
#   cd services\worker; .venv\Scripts\python.exe -m studio.supa web-env
# O build é bloqueado se uma chave secreta for colocada aqui.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
