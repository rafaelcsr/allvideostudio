# Copie para .env (nunca versionado) e preencha. Este arquivo vira o Secret do Modal:
#   modal secret create ai-video-studio --from-dotenv .env --force

# --- Supabase (docs/SUPABASE.md) ---
# Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Project Settings > API Keys > Publishable key (sb_publishable_...)  — PÚBLICA, vai para o navegador
SUPABASE_PUBLISHABLE_KEY=
# Project Settings > API Keys > Secret key (sb_secret_...)  — PRIVILEGIADA, só servidor/worker
SUPABASE_SECRET_KEY=
# (projetos antigos: SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY também são aceitos)
# Connect > Session pooler (IPv4, porta 5432), com a senha do banco no lugar de [YOUR-PASSWORD].
# Usada SOMENTE localmente para aplicar migrations; não é enviada ao Modal nem ao frontend.
SUPABASE_DB_URL=

# --- Cloudflare R2 (R2 > Manage API tokens: Object Read & Write, só este bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-video-studio

# --- Anthropic (console.anthropic.com > API keys; defina um spend limit no console) ---
ANTHROPIC_API_KEY=
EDITORIAL_MODEL=claude-opus-5-5
EDITORIAL_EFFORT=medium

# --- Acesso ---
ALLOWED_EMAILS=rafaelcsr22@gmail.com
CORS_ORIGINS=https://ai-video-studio.pages.dev,http://localhost:3000

# --- Proteções financeiras ---
MONTHLY_BUDGET_BRL=100
USD_BRL=5.5
BUDGET_ALERT_PCT=0.8
MAX_VIDEO_MINUTES=30
MAX_UPLOAD_MB=4000
MAX_JOBS_PER_DAY=12
MAX_LLM_USD_PER_JOB=0.75
MAX_SHORTS_PER_JOB=5
STORAGE_CAP_GB=9

# --- Transcrição ---
WHISPER_MODEL=large-v3-turbo
